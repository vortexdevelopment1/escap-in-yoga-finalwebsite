# Example Environment Configuration
# Copy this to .env.local on your local machine or add directly in Vercel Project Settings

# Cloudinary assets
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=escape_in_yoga
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Live Backend API URL (optional when deploying fullstack)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# 👑 Admin Credentials for Teacher Portal (/admin)
# Managers can change these anytime in Vercel > Settings > Environment Variables
NEXT_PUBLIC_ADMIN_EMAIL=vortex@gmail.com
NEXT_PUBLIC_ADMIN_PASSWORD=YogaAdmin@2026
